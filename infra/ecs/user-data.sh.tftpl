#!/bin/bash
set -euo pipefail
mkdir -p /etc/ecs /etc/systemd/system/ecs.service.d
cat > /etc/ecs/ecs.config <<'CONFIG'
ECS_CLUSTER=${cluster}
ECS_ENABLE_AWSLOGS_EXECUTIONROLE_OVERRIDE=true
ECS_ENABLE_TASK_IAM_ROLE=true
ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST=true
ECS_INSTANCE_ATTRIBUTES={"workbench_node":"${name}"}
CONFIG
cat > /usr/local/sbin/riotx-mount-data <<'MOUNT'
#!/bin/bash
set -euo pipefail
# Identify the exact EBS disk by its NVMe serial; never guess /dev/nvme1n1.
expected_serial=$(printf '%s' '${volume_id}' | tr -d '-')
device=''
for attempt in $(seq 1 180); do
  device=$(lsblk -dn -o PATH,SERIAL | awk -v expected="$expected_serial" '$2 == expected {print $1; exit}')
  [[ -z "$device" ]] || break
  sleep 5
done
[[ -b "$device" ]] || { echo 'Expected data EBS volume not attached.' >&2; exit 1; }
filesystem=$(blkid -o value -s TYPE "$device" || true)
if [[ -z "$filesystem" ]]; then
  # Refuse to format a disk with any existing partition/filesystem signatures.
  [[ -z "$(wipefs --no-act --noheadings --output TYPE "$device")" ]] || exit 1
  mkfs.ext4 "$device"
elif [[ "$filesystem" != ext4 ]]; then
  echo 'Unexpected data filesystem; refusing to modify it.' >&2; exit 1
fi
disk_uuid=$(blkid -s UUID -o value "$device")
mkdir -p /var/lib/riotx-data
if ! grep -Fq "UUID=$disk_uuid " /etc/fstab; then
  printf 'UUID=%s /var/lib/riotx-data ext4 defaults 0 2\n' "$disk_uuid" >> /etc/fstab
fi
if ! mountpoint -q /var/lib/riotx-data; then mount /var/lib/riotx-data; fi
[[ "$(findmnt -n -o UUID /var/lib/riotx-data)" == "$disk_uuid" ]] || exit 1
chown 10001:10001 /var/lib/riotx-data
chmod 700 /var/lib/riotx-data
MOUNT
chmod 750 /usr/local/sbin/riotx-mount-data
cat > /etc/systemd/system/riotx-data.service <<'UNIT'
[Unit]
Description=Mount the persistent RIOTX EBS volume before registering with ECS
After=network-online.target
Wants=network-online.target
Before=ecs.service
[Service]
Type=oneshot
ExecStart=/usr/local/sbin/riotx-mount-data
RemainAfterExit=yes
TimeoutStartSec=1000
[Install]
WantedBy=multi-user.target
UNIT
cat > /etc/systemd/system/ecs.service.d/data.conf <<'UNIT'
[Unit]
Requires=riotx-data.service
After=riotx-data.service
UNIT
systemctl daemon-reload
# ECS/Docker units wait for cloud-init; do not block cloud-init on their startup.
systemctl enable --now --no-block ecs.service
